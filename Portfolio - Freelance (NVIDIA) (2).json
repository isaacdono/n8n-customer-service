      "id": "f2b27d40-b534-41dd-8da4-14bb0c22484b",
      "name": "Ler Pedidos da Semana (Sheets)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        3584,
