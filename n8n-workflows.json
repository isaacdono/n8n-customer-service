      "id": "4cf11eb8-0a2c-46e7-a4ac-de27fc9127c6",
      "name": "Ler Pedidos da Semana (Sheets)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2560,
        1824
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst agora = new Date();\nconst umaSemanaAtras = new Date();\numaSemanaAtras.setDate(agora.getDate() - 7);\numaSemanaAtras.setHours(0, 0, 0, 0);\n\nconst pedidosSemana = rows.filter(r => {\n  if (!r.data) return false;\n  const [d, m, y] = r.data.split(\"/\");\n  const dataPedido = new Date(`${y}-${m}-${d}`);\n  return dataPedido >= umaSemanaAtras;\n});\n\nconst totalPedidos = pedidosSemana.length;\nconst faturamento = pedidosSemana.reduce((acc, r) => {\n  const val = parseFloat(\n    (r.total || \"0\").toString().replace(\"R$\", \"\").replace(\",\", \".\").trim()\n  );\n  return acc + (isNaN(val) ? 0 : val);\n}, 0);\n\nconst contagem = {};\npedidosSemana.forEach(r => {\n  const itens = (r.itens || \"\").split(\",\");\n  itens.forEach(item => {\n    const match = item.trim().match(/^(\\d+)x\\s*(.+)/i);\n    if (match) {\n      const qtd = parseInt(match[1]);\n      const key = match[2].trim();\n      contagem[key] = (contagem[key] || 0) + qtd;\n    } else {\n      const key = item.trim();\n      if (key) contagem[key] = (contagem[key] || 0) + 1;\n    }\n  });\n});\n\nconst ranking = Object.entries(contagem)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 5)\n  .map(([item, qtd], i) => `${i + 1}. ${item} (${qtd}x)`)\n  .join(\"\\n\");\n\nconst mensagem = `*Relatorio Semanal do Restaurante*\\n\\n` +\n  `Total de pedidos: ${totalPedidos}\\n` +\n  `Faturamento estimado: R$ ${faturamento.toFixed(2).replace(\".\", \",\")}\\n` +\n  `Ticket medio: R$ ${totalPedidos > 0 ? (faturamento / totalPedidos).toFixed(2).replace(\".\", \",\") : \"0,00\"}\\n\\n` +\n  `*Top 5 itens mais pedidos:*\\n${ranking || \"Sem dados suficientes\"}`;\n\nreturn [{ json: { mensagem } }];"
      },
      "id": "c7f48653-177b-4f5a-8005-8356f8ae7a32",
      "name": "Calcular Relatório",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2784,
        1824
      ]
    },
