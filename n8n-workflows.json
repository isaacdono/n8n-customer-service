    {
      "parameters": {
        "jsCode": "const eventos = $input.all().map(i => i.json).filter(e => e && e.id);\n\nif (eventos.length === 0) {\n  return [{ json: { vazio: true } }];\n}\n\nconst lista = eventos.map(e => {\n  const inicio = e.start?.dateTime || e.start?.date || '';\n  const horario = inicio.includes('T')\n    ? new Date(inicio).toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' })\n    : inicio;\n  return `- ${horario}: ${e.summary || 'Consulta'}`;\n}).join('\\n');\n\nreturn [{\n  json: {\n    vazio: false,\n    output: `*Lembrete de Consultas de Amanhã:*\\n${lista}`\n  }\n}];"
      },
