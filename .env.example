# ============================================
# Gateway Unificado WhatsApp - Variáveis
# ============================================

# n8n Webhook URLs (ajuste conforme seu ambiente)
# Se n8n está no mesmo Docker Compose, deixe como está
N8N_WEBHOOK_URL=http://localhost:5678

# Se n8n está em outra máquina:
# N8N_FALA=http://192.168.1.100:5678/webhook/fala
# N8N_CLINICA=http://192.168.1.100:5678/webhook/clinica
# N8N_RESTAURANTE=http://192.168.1.100:5678/webhook/restaurante

# Ou deixe os defaults (vai usar n8n do Docker Compose):
N8N_FALA=http://n8n:5678/webhook/fala
N8N_CLINICA=http://n8n:5678/webhook/clinica
N8N_RESTAURANTE=http://n8n:5678/webhook/restaurante

# FastAPI
FASTAPI_URL=http://fastapi-service:8000
WWEBJS_SEND_URL=http://wwebjs-service:3000/send

# Ambiente
NODE_ENV=production
