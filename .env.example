# =============================================================================
# OpenRouter LLM Configuration
# =============================================================================
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# =============================================================================
# WhatsApp Gateway (wwebjs) & FastAPI Router
# =============================================================================
FASTAPI_URL=http://fastapi-service:8000
WWEBJS_SEND_URL=http://wwebjs-service:3000/send

# =============================================================================
# PostgreSQL (n8n DB, Chat History, Session State & BI Views)
# =============================================================================
POSTGRES_USER=chatuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=chat_history
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chatuser:CHANGE_ME_STRONG_PASSWORD@postgresql:5432/chat_history

# =============================================================================
# n8n Server & Webhook Endpoints
# =============================================================================
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678
N8N_CLINICA=http://n8n:5678/webhook/clinica
N8N_RESTAURANTE=http://n8n:5678/webhook/restaurante

# =============================================================================
# External Integrations Placeholders (Configured inside n8n UI / Workflows)
# =============================================================================
GOOGLE_CALENDAR_EMAIL=YOUR_GOOGLE_CALENDAR_EMAIL
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID
OWNER_WHATSAPP_LID=YOUR_WHATSAPP_LID
