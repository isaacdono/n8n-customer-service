      "id": "ler_estoque",
      "name": "Ler Estoque (Sheets)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -180,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "const itens = $input.all().map(i => i.json);\nconst criticos = itens.filter(i => {\n  const qtd = parseFloat(i.quantidade) || 0;\n  const minimo = parseFloat(i.minimo) || 0;\n  return qtd <= minimo;\n});\n\nif (criticos.length === 0) return [];\n\nconst lista = criticos.map(i => `⚠️ ${i.ingrediente}: ${i.quantidade} ${i.unidade} (mín: ${i.minimo})`).join('\\n');\nconst mensagem = `🚨 *Alerta de Estoque Baixo*\\n\\n${lista}\\n\\nAtualize o estoque antes de abrir!`;\n\nreturn [{ json: { mensagem, temAlerta: true } }];"
      },
      "id": "checar_estoque_baixo",
      "name": "Checar Estoque Baixo",
      "type": "n8n-nodes-base.code",
