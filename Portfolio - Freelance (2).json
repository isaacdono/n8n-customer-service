    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst umaSemanaAtras = new Date();\numaSemanaAtras.setDate(umaSemanaAtras.getDate() - 7);\n\nconst pedidosSemana = rows.filter(r => {\n  if (!r.data) return false;\n  const [d, m, y] = r.data.split('/');\n  return new Date(`${y}-${m}-${d}`) >= umaSemanaAtras;\n});\n\nconst totalPedidos = pedidosSemana.length;\nconst faturamento = pedidosSemana.reduce((acc, r) => {\n  const val = parseFloat((r.total || '0').toString().replace('R$','').replace(',','.').trim());\n  return acc + (isNaN(val) ? 0 : val);\n}, 0);\n\n// Ranking de itens\nconst contagem = {};\npedidosSemana.forEach(r => {\n  const itens = (r.itens || '').split(',');\n  itens.forEach(item => {\n    const key = item.trim();\n    if (key) contagem[key] = (contagem[key] || 0) + 1;\n  });\n});\n\nconst ranking = Object.entries(contagem)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 5)\n  .map(([item, qtd], i) => `${i+1}. ${item} (${qtd}x)`)\n  .join('\\n');\n\nconst mensagem = `📊 *Relatório Semanal do Restaurante*\\n\\n` +\n  `📦 Total de pedidos: ${totalPedidos}\\n` +\n  `💰 Faturamento estimado: R$ ${faturamento.toFixed(2).replace('.',',')}\\n` +\n  `📈 Ticket médio: R$ ${totalPedidos > 0 ? (faturamento/totalPedidos).toFixed(2).replace('.',',') : '0,00'}\\n\\n` +\n  `🏆 *Top 5 itens mais pedidos:*\\n${ranking || 'Sem dados suficientes'}\\n\\n` +\n  `_Bora mais essa semana! 💪_`;\n\nreturn [{ json: { mensagem } }];"
      },
